<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!-- Aspire AppHost SDK version lives inline here (not in Directory.Packages.props); bump via 'aspire update'. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>trellis-apphost-e6c5a3d2</UserSecretsId>
    <!-- Aspire 13.5 can download a DCP + dashboard "CLI bundle" into the build. We deliberately do
         not: `aspire run` is a local-host workflow that brings its own CLI (ADR-0008), and CI only
         ever drives the AppHost through Aspire.Hosting.Testing, which the E2E proves works without
         the bundle. Opting out keeps restore lean; ASPIRE010 only nags about the choice. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <!--#if (IncludeUI) -->
  <PropertyGroup>
    <!-- Defines IncludeUI for the template SOURCE so the #if block in Program.cs compiles here.
         Removed at 'dotnet new' time when the UI is excluded; harmless when included. -->
    <DefineConstants>$(DefineConstants);IncludeUI</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <!--#if (UseRedis) -->
    <PackageReference Include="Aspire.Hosting.Redis" />
    <!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!-- A library, not a resource: IsAspireProjectResource="false" makes this an ordinary reference the
         AppHost compiles against (the ServiceNames constants), where every other reference here is a
         project Aspire runs. -->
    <ProjectReference Include="..\..\src\Shared\Trellis.ServiceDefaults\Trellis.ServiceDefaults.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Presentation\Api\Trellis.Api\Trellis.Api.csproj" />
    <!--#if (IncludeUI) -->
    <ProjectReference Include="..\..\src\Presentation\UI\Trellis.UI.Web\Trellis.UI.Web.csproj" />
    <!--#endif -->
    <ProjectReference Include="..\Trellis.MigrationService\Trellis.MigrationService.csproj" />
  </ItemGroup>

</Project>
