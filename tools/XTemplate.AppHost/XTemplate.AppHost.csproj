<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <!-- Aspire AppHost SDK version lives inline here (not in Directory.Packages.props); bump via 'aspire update'. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>xtemplate-apphost-e6c5a3d2</UserSecretsId>
  </PropertyGroup>
  <!--#if (IncludeUI) -->
  <PropertyGroup>
    <!-- Defines the IncludeUI symbol for the template SOURCE so the #if block in Program.cs compiles here.
         Removed at 'dotnet new' time when the UI is excluded; harmless when included. -->
    <DefineConstants>$(DefineConstants);IncludeUI</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Presentation\Api\XTemplate.Api\XTemplate.Api.csproj" />
    <!--#if (IncludeUI) -->
    <ProjectReference Include="..\..\src\Presentation\UI\XTemplate.UI.Web\XTemplate.UI.Web.csproj" />
    <!--#endif -->
    <ProjectReference Include="..\XTemplate.MigrationService\XTemplate.MigrationService.csproj" />
  </ItemGroup>

</Project>
