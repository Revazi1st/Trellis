<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Trellis.Templates</PackageId>
    <Title>Trellis Clean Architecture Solution Template</Title>
    <Authors>Trellis contributors</Authors>
    <Description>A rich-DDD, Clean Architecture .NET 10 solution template: feature-based minimal APIs, separate Infrastructure and Persistence, Aspire orchestration, Blazor UI, and an AI-friendly repository.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;ddd;cqrs;vertical-slice;aspire;blazor;postgresql</PackageTags>
    <Version>0.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Revazi1st/Trellis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Revazi1st/Trellis</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Critical: the template ships dotfiles (.editorconfig, .gitignore, .claude/, .mcp.json, .config/). -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <!-- What never ships. KEEP IN SYNC with "sources[0].exclude" in .template.config/template.json
         (that list guards folder installs, this one guards the package) and with .gitignore: build
         output, packaging infra, machine-local and IDE state, OS litter, test/coverage output, and
         every pattern .gitignore treats as a secret. ".git" is listed as a file as well as a folder:
         a git worktree or submodule has a .git FILE, which "\.git\**" does not match.
         The template's own governance files (README, the README.redesign.md candidate and its
         eng/readme pictures, CHANGELOG, CONTRIBUTING, CODE_OF_CONDUCT, SECURITY, CODEOWNERS, issue
         forms, the release runbook) are maintainer material: generated projects get the stubs in
         .template.config/consumer/ instead. template.json itself is listed because the package
         carries the stamped copy (StampTemplateVersion below). -->
    <TemplateContentExclude>
      ..\..\**\bin\**;
      ..\..\**\obj\**;
      ..\..\artifacts\**;
      ..\..\.git;
      ..\..\.git\**;
      ..\..\.idea\**;
      ..\..\.vs\**;
      ..\..\.vscode\**;
      ..\..\eng\Trellis.TemplatePack\**;
      ..\..\eng\Directory.Build.props;
      ..\..\eng\Directory.Build.targets;
      ..\..\eng\readme\**;
      ..\..\.template.config\template.json;
      ..\..\.github\workflows\template-ci.yml;
      ..\..\.github\workflows\release.yml;
      ..\..\.claude\skills\add-toggle\**;
      ..\..\scripts\check-template-toggles.sh;
      ..\..\docs\releasing.md;
      ..\..\README.md;
      ..\..\README.redesign.md;
      ..\..\CHANGELOG.md;
      ..\..\CONTRIBUTING.md;
      ..\..\CODE_OF_CONDUCT.md;
      ..\..\SECURITY.md;
      ..\..\.github\CODEOWNERS;
      ..\..\.github\ISSUE_TEMPLATE\**;
      ..\..\.claude\settings.local.json;
      ..\..\.claude\worktrees\**;
      ..\..\CLAUDE.local.md;
      ..\..\**\*.user;
      ..\..\**\*.suo;
      ..\..\**\.DS_Store;
      ..\..\**\.aspire\**;
      ..\..\**\TestResults\**;
      ..\..\**\nupkg\**;
      ..\..\**\*.trx;
      ..\..\**\coverage*.json;
      ..\..\**\coverage*.xml;
      ..\..\**\*.coverage;
      ..\..\**\appsettings.*.local.json;
      ..\..\**\*.pfx;
      ..\..\**\*.key
    </TemplateContentExclude>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- The same file the IDEs show through ide.host.json; its SVG source sits beside it. -->
    <None Include="..\..\.template.config\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the whole repo (from two levels up) as template content, minus $(TemplateContentExclude).
         An explicit PackagePath is REQUIRED: these items live outside the project cone, so
         ContentTargetFolders cannot derive a relative path and would flatten all files into
         content/ — dropping colliding names (Program.cs, appsettings.json, ...) and losing
         .template.config/, which makes the package unrecognisable as a template.
         The path must be the bare folder "content": NuGet treats an extension-less PackagePath as a
         destination FOLDER and appends %(RecursiveDir)%(Filename)%(Extension) itself. Spelling the
         file name out (content\%(RecursiveDir)%(Filename)%(Extension)) breaks the extension-less
         files — LICENSE, CODEOWNERS, Dockerfile — whose "file path" is itself extension-less and
         therefore treated as a folder, nesting them one level deep (content/LICENSE/LICENSE). -->
    <Content Include="..\..\**\*"
             Exclude="$(TemplateContentExclude)"
             PackagePath="content" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <!-- The generated .trellis-template.json marker records the template version through the
       templateVersion symbol. The repository's template.json says 0.0.0-source (what a folder install
       from a checkout records); the packed copy says $(Version), so the version is stated once: in
       <Version> above, or by release.yml's -p:Version. Fails the pack if the placeholder is gone. -->
  <PropertyGroup>
    <TemplateConfigSource>$(MSBuildThisFileDirectory)..\..\.template.config\template.json</TemplateConfigSource>
    <TemplateConfigStamped>$(BaseIntermediateOutputPath)stamped\template.json</TemplateConfigStamped>
    <TemplateVersionPlaceholder>"value": "0.0.0-source"</TemplateVersionPlaceholder>
  </PropertyGroup>

  <!-- A code task, not WriteLinesToFile: an item list would split template.json at ';' and turn
       its backslash escapes into path separators. -->
  <UsingTask TaskName="StampTemplateVersionText"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
      <Placeholder ParameterType="System.String" Required="true" />
      <Replacement ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = File.ReadAllText(SourceFile);
        if (!text.Contains(Placeholder))
        {
            Log.LogError("{0} no longer contains {1} (the templateVersion symbol), so the package cannot record its version in the generated marker.", SourceFile, Placeholder);
        }
        else
        {
            string stamped = text.Replace(Placeholder, Replacement);
            Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
            if (!File.Exists(DestinationFile) || File.ReadAllText(DestinationFile) != stamped)
            {
                File.WriteAllText(DestinationFile, stamped);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StampTemplateVersion" BeforeTargets="_GetPackageFiles">
    <StampTemplateVersionText SourceFile="$(TemplateConfigSource)"
                              DestinationFile="$(TemplateConfigStamped)"
                              Placeholder="$(TemplateVersionPlaceholder)"
                              Replacement="&quot;value&quot;: &quot;$(Version)&quot;" />
    <ItemGroup>
      <Content Include="$(TemplateConfigStamped)" PackagePath="content\.template.config\template.json" />
    </ItemGroup>
  </Target>

</Project>
