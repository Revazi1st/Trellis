<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Trellis.Templates</PackageId>
    <Title>Trellis Clean Architecture Solution Template</Title>
    <Authors>Trellis</Authors>
    <Description>A rich-DDD, Clean Architecture .NET 10 solution template: feature-based minimal APIs, separate Infrastructure and Persistence, Aspire orchestration, Blazor UI, and an AI-friendly repository.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;ddd;aspire;blazor</PackageTags>
    <Version>0.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Revazi1st/trellis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Revazi1st/trellis</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Critical: the template ships dotfiles (.editorconfig, .gitignore, .claude/, .mcp.json, .config/). -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <!-- What never ships. KEEP IN SYNC with "sources[0].exclude" in .template.config/template.json
         (that list guards folder installs, this one guards the package) and with .gitignore: build
         output, packaging infra, machine-local and IDE state, OS litter, test/coverage output, and
         every pattern .gitignore treats as a secret. ".git" is listed as a file as well as a folder:
         a git worktree or submodule has a .git FILE, which "\.git\**" does not match. -->
    <TemplateContentExclude>
      ..\..\**\bin\**;
      ..\..\**\obj\**;
      ..\..\artifacts\**;
      ..\..\.git;
      ..\..\.git\**;
      ..\..\.idea\**;
      ..\..\.vs\**;
      ..\..\.vscode\**;
      ..\..\eng\**;
      ..\..\.github\workflows\template-ci.yml;
      ..\..\.github\workflows\release.yml;
      ..\..\.claude\settings.local.json;
      ..\..\.claude\worktrees\**;
      ..\..\CLAUDE.local.md;
      ..\..\**\*.user;
      ..\..\**\*.suo;
      ..\..\**\.DS_Store;
      ..\..\**\.aspire\**;
      ..\..\**\TestResults\**;
      ..\..\**\nupkg\**;
      ..\..\**\*.trx;
      ..\..\**\coverage*.json;
      ..\..\**\coverage*.xml;
      ..\..\**\*.coverage;
      ..\..\**\appsettings.*.local.json;
      ..\..\**\*.pfx;
      ..\..\**\*.key
    </TemplateContentExclude>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the whole repo (from two levels up) as template content, minus $(TemplateContentExclude).
         An explicit PackagePath is REQUIRED: these items live outside the project cone, so
         ContentTargetFolders cannot derive a relative path and would flatten all files into
         content/ — dropping colliding names (Program.cs, appsettings.json, ...) and losing
         .template.config/, which makes the package unrecognisable as a template.
         The path must be the bare folder "content": NuGet treats an extension-less PackagePath as a
         destination FOLDER and appends %(RecursiveDir)%(Filename)%(Extension) itself. Spelling the
         file name out (content\%(RecursiveDir)%(Filename)%(Extension)) breaks the extension-less
         files — LICENSE, CODEOWNERS, Dockerfile — whose "file path" is itself extension-less and
         therefore treated as a folder, nesting them one level deep (content/LICENSE/LICENSE). -->
    <Content Include="..\..\**\*"
             Exclude="$(TemplateContentExclude)"
             PackagePath="content" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
