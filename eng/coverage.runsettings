<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for the CI test run (.github/workflows/ci.yml, "Test (with coverage)"),
  passed to dotnet-coverage collect as its settings file: it reads the Code Coverage data
  collector's Configuration below, in the standard RunSettings shape. The step and the summary
  script (.github/scripts/coverage-summary.py) run the same way on any x64 host; dotnet-coverage
  ships no profiler for Linux or macOS on arm64, where it reports no data.

  What is measured is the solution's own production code, nothing else:
    - only the solution's assemblies; third-party packages that ship symbols (FluentValidation,
      Docker.DotNet, Aspire.Hosting, ...) would otherwise dominate the totals;
    - not the test assemblies: a test that ran is not coverage of the code under test;
    - not EF Core migrations (generated by dotnet-ef, never hand-edited);
    - not generated code: source-generator output (obj/, *.g.cs, *.generated.cs, such as the
      OpenAPI XML-comment support) and anything marked GeneratedCode or ExcludeFromCodeCoverage.
  Compiler-generated members (async state machines, lambdas, record equality) stay in on purpose:
  excluding CompilerGeneratedAttribute would drop the bodies of every async method.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]Trellis\.[^\\/]*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
                <Source>.*\.g\.cs$</Source>
                <Source>.*\.generated\.cs$</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
