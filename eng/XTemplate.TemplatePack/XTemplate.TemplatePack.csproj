<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>XTemplate.Templates</PackageId>
    <Title>XTemplate Clean Architecture Solution Template</Title>
    <Authors>XTemplate</Authors>
    <Description>A rich-DDD, Clean Architecture .NET 10 solution template: feature-based minimal APIs, separate Infrastructure and Persistence, Aspire orchestration, Blazor UI, and an AI-friendly repository.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;ddd;aspire;blazor</PackageTags>
    <Version>0.1.0</Version>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Critical: the template ships dotfiles (.editorconfig, .gitignore, .claude/, .mcp.json, .config/). -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack the whole repo (from two levels up) as template content, minus build output and packaging infra. -->
    <Content Include="..\..\**\*"
             Exclude="..\..\**\bin\**;..\..\**\obj\**;..\..\artifacts\**;..\..\.git\**;..\..\.idea\**;..\..\.vs\**;..\..\eng\**;..\..\**\.template-test\**;..\..\.claude\settings.local.json" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
