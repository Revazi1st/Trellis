<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    ═══════════════════════════════════════════════════════════════════════════════════
    LICENSE CEILINGS — DO NOT CROSS (applies to humans and AI agents alike)

    The following packages moved to commercial licenses (or, for Moq, broke the trust a
    build dependency needs). This solution deliberately avoids them; never add or upgrade to:
      • MediatR >= 13.0.0            (Lucky Penny, RPL-1.5/commercial) — we hand-roll CQRS handlers
      • AutoMapper >= 15.0.0         (Lucky Penny, RPL-1.5/commercial) — we map manually
      • FluentAssertions >= 8.0.0    (Xceed, proprietary)              — we use Shouldly
      • MassTransit >= 9.0.0         (Massient, commercial)            — use Wolverine/Rebus if messaging is needed
      • Moq, any version             (4.20.0 shipped SponsorLink)      — we use NSubstitute
    Enforced, not advisory: the build fails when any of these ids appears anywhere in a
    project's resolved package graph, transitive dependencies included (Directory.Build.props),
    and Dependabot never proposes them (.github/dependabot.yml).
    Rationale: docs/adr/0011-license-ceiling-policy.md
    ═══════════════════════════════════════════════════════════════════════════════════
    All versions below verified against nuget.org on 2026-09-25.
  -->

  <ItemGroup Label="Analyzers (all projects)">
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.299" />
  </ItemGroup>

  <ItemGroup Label="Domain / Application">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Transitive pin: Microsoft.AspNetCore.OpenApi pulls Microsoft.OpenApi 2.0.0, which has GHSA-v5pm-xwqc-g5wc. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.10" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Logging (optional Serilog)">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Aspire / ServiceDefaults">
    <!-- Aspire.Hosting.AppHost is implicit via the Aspire.AppHost.Sdk (version pinned inline in the AppHost csproj);
         a PackageVersion entry for it here triggers NU1009. -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- In-process API endpoint tests (WebApplicationFactory) — runs inside the SDK container, unlike the Aspire E2E. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- TRX reports for CI failure artifacts (out-of-process safe, unlike the in-process coverage extension).
         Version MUST track the Microsoft.Testing.Platform that xunit.v3 runs on, or the test host dies with
         "Could not load type 'IDataConsumer' from Microsoft.Testing.Platform". xunit.v3 4.x ships platform
         2.x (4.0.2 pulls platform 2.5.1), so 4.0.2 and 2.5.1 move together — never bump one alone. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Transitive pin (via Testcontainers): 2025.1.0 and below carry GHSA-q939-rpr3-3284, which NuGetAudit rightly flags. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

</Project>
