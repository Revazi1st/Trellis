<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser-driven UI tests. The project always builds (so the code is compile-verified), but the
       browser tests are opt-in: set RUN_UI_TESTS=1 and install the browser first
       (`pwsh artifacts/bin/Trellis.UiTests/debug/playwright.ps1 install chromium`). They start the
       application themselves, through the AppHost (AppHostFixture), unless UI_TESTS_BASE_URL names
       one that is already running. CI runs them; the SDK container skips them. -->

  <ItemGroup>
    <!-- The AppHost the fixture starts, and the resource names it waits for. -->
    <ProjectReference Include="..\..\tools\Trellis.AppHost\Trellis.AppHost.csproj" />
    <ProjectReference Include="..\..\src\Shared\Trellis.ServiceDefaults\Trellis.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- Shared test support (tests/TestSupport), linked as in ApiTests: the step that keeps an Aspire
       test away from the developer's own database, and the watch that ends a start when a resource
       the application needs fails. -->
  <ItemGroup>
    <Compile Include="..\TestSupport\AppHost\AppHostTestingExtensions.cs" Link="TestSupport\AppHost\AppHostTestingExtensions.cs" />
  </ItemGroup>

</Project>
