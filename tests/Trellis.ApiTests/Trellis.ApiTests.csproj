<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Trellis.AppHost\Trellis.AppHost.csproj" />
    <!-- Aliased: both the AppHost and the Api define a top-level Program; the in-process factory needs the Api's. -->
    <ProjectReference Include="..\..\src\Presentation\Api\Trellis.Api\Trellis.Api.csproj" Aliases="apihost" />
    <ProjectReference Include="..\..\src\Presentation\Api\Trellis.Api.Contracts\Trellis.Api.Contracts.csproj" />
    <!--#if (IncludeUI) -->
    <!-- The UI client tests (Ui/) drive UI.Common's typed clients and token provider over fake handlers. -->
    <ProjectReference Include="..\..\src\Presentation\UI\Trellis.UI.Common\Trellis.UI.Common.csproj" />
    <!-- The web host itself, for the Production-mode /Error test (Ui/WebHostTests). Aliased like the Api:
         its top-level Program would otherwise clash with the Api's. -->
    <ProjectReference Include="..\..\src\Presentation\UI\Trellis.UI.Web\Trellis.UI.Web.csproj" Aliases="webhost" />
    <!--#endif -->
  </ItemGroup>

  <!--#if (IncludeUI) -->
  <PropertyGroup>
    <!-- Defines IncludeUI for the template SOURCE so the Ui/ tests compile here.
         Removed at 'dotnet new' time when the UI is excluded. -->
    <DefineConstants>$(DefineConstants);IncludeUI</DefineConstants>
  </PropertyGroup>
  <!--#endif -->

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- Shared test support (tests/TestSupport): one source file compiled into each test project that sees the
       SharedKernel, no project of its own. ShouldBeSuccess() comes with the global using; the test database
       (TestSupport/Database: ITestDatabase and the server it starts) here and in IntegrationTests, every
       file in that folder in both, so a file there uses only what both projects reference (this one has
       no Respawn); and the AppHost's start (TestSupport/AppHost: UseThrowawayDatabase, and the watch that
       ends a start when a resource it needs fails) here and, with the browser tests, in UiTests, so that
       file uses only what both reference (UiTests sees neither the SharedKernel nor the
       Trellis.TestSupport global using). -->
  <ItemGroup>
    <Compile Include="..\TestSupport\ResultAssertions.cs" Link="TestSupport\ResultAssertions.cs" />
    <Compile Include="..\TestSupport\Database\*.cs" LinkBase="TestSupport\Database" />
    <Compile Include="..\TestSupport\AppHost\AppHostTestingExtensions.cs" Link="TestSupport\AppHost\AppHostTestingExtensions.cs" />
    <Using Include="Trellis.TestSupport" />
  </ItemGroup>

</Project>
