{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/dotnet.sh:*)",
      "Bash(./scripts/ef.sh:*)",
      "Bash(./scripts/check-docs-drift.sh:*)",
      "Bash(./scripts/check-adr-history.sh:*)",
      "Bash(./scripts/check-adr-links.sh:*)",
      "Bash(./scripts/check-hooks.sh:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-edits.sh",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-commit.sh",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/docs-drift.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-tests.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
