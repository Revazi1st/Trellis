<Project>

  <PropertyGroup Label="Framework">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <!-- Single artifacts/ tree at repo root: artifacts/<bin|obj|publish>/<Project>/<pivot>. Must be set here, not in a csproj (NETSDK1199).
         ArtifactsPath is pinned explicitly so projects under nested Directory.Build.props (tests/) don't compute their own root. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Warnings block only Release/CI builds; the inner dev loop stays fast. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release' or '$(ContinuousIntegrationBuild)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Documentation">
    <!-- XML docs feed the built-in OpenAPI generator; CS1591 (missing comment) stays opt-in per type. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <!-- Deterministic, reproducible builds; ContinuousIntegrationBuild is auto-set on CI (also gates warnings-as-errors above).
         PublishRepositoryUrl + EmbedUntrackedSources enable the SDK's built-in SourceLink for GitHub-hosted repos. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Label="Supply chain">
    <!-- NuGet vulnerability auditing on the full graph (transitive included). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- The LICENSE CEILINGS in Directory.Packages.props are enforced, not advisory (ADR-0011).
       Catches direct references; Dependabot's ignore list covers the bot-upgrade path.
       CAUTION: 'dotnet new' evaluates Condition attributes containing item syntax (%/@) and mangles
       them in generated output (the reason this repo uses XML-comment conditionals, ADR-0010) —
       hence the double-Exclude intersection and the property-only Error condition. -->
  <Target Name="EnforceLicenseCeilings" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_ForbiddenPackageNames Include="MediatR;AutoMapper;FluentAssertions;MassTransit;Moq" />
      <_AllowedPackageReferences Include="@(PackageReference)" Exclude="@(_ForbiddenPackageNames)" />
      <_LicenseViolations Include="@(PackageReference)" Exclude="@(_AllowedPackageReferences)" />
    </ItemGroup>
    <PropertyGroup>
      <_LicenseViolationList>@(_LicenseViolations)</_LicenseViolationList>
    </PropertyGroup>
    <Error Condition="'$(_LicenseViolationList)' != ''"
      Text="Package(s) '$(_LicenseViolationList)' violate the license-ceiling policy (ADR-0011; see LICENSE CEILINGS in Directory.Packages.props for the free alternatives)." />
  </Target>

</Project>
