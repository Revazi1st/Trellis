# Normalize line endings: text files are LF in the repo, auto-converted on checkout.
* text=auto eol=lf

# Explicit text types
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.razor     text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.editorconfig text eol=lf

# Windows-only scripts keep CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary
*.png       binary
*.ico       binary
*.pfx       binary

# Collapse generated migrations in diffs/reviews
**/Migrations/*.cs        linguist-generated=true
**/*.Designer.cs          linguist-generated=true
