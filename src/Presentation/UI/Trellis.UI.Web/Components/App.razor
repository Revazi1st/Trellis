<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/Trellis.UI.Common/app.css" />
    <link rel="icon" href="data:," />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    @* The host applies interactivity; UI.Common stays render-mode-agnostic (ADR-0015).
       Without this, AddInteractiveServerRenderMode() only *enables* the mode and every
       page renders as static SSR — EditForm handlers never fire. A page marked
       [ExcludeFromInteractiveRouting] (the /Error page) renders statically instead: it must
       work when the app is too broken to start a circuit. *@
    <Routes @rendermode="PageRenderMode" />

    @* Shown by blazor.web.js when the circuit fails outside every ErrorBoundary (hidden by app.css). *@
    <div id="blazor-error-ui" role="alert" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss">✕</button>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
