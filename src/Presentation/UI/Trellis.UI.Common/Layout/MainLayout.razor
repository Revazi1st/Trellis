@inherits LayoutComponentBase

<div class="page">
    <header class="topbar">
        <a class="brand" href="">Trellis</a>
        <nav class="nav" aria-label="Main">
            <AuthorizeView>
                <Authorized>
                    <NavLink href="invoices" class="nav-link">Invoices</NavLink>
                    <AuthorizeView Roles="invoices:write" Context="writer">
                        <NavLink href="invoices/new" class="nav-link">New</NavLink>
                    </AuthorizeView>
                    <span class="user">@context.User.Identity?.Name</span>
                    <button class="link-button" @onclick="SignOutAsync">Sign out</button>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="login" class="nav-link">Sign in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>
    <main class="content">
        <Notifications />
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="error-panel" role="alert">
                    <h1>Something went wrong</h1>
                    <p>An unexpected error occurred. You can try again.</p>
                    <button @onclick="Recover">Retry</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    [Inject] private TokenAuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private ErrorBoundary? _errorBoundary;

    // Clear a caught error when the user navigates to a new page.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Recover() => _errorBoundary?.Recover();

    // The local sign-out is immediate (a protected page reacts by redirecting itself) and the API revoke
    // follows, best-effort. Then sign-in without a return address: signing out is not a detour.
    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
