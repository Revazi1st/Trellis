@page "/login"
@using Microsoft.Extensions.Options
@inject IAuthApiClient AuthApi
@inject IOptions<UiOptions> UiOptions
@inject TokenAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Sign in — Trellis</PageTitle>

<h1>Sign in</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form">
    <DataAnnotationsValidator />

    <label>
        Email
        <InputText @bind-Value="_model.Email" autocomplete="username" />
        <ValidationMessage For="() => _model.Email" />
    </label>
    <label>
        Password
        <InputText type="password" @bind-Value="_model.Password" autocomplete="current-password" />
        <ValidationMessage For="() => _model.Password" />
    </label>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
    <p class="hint">
        @* Well-known local-dev credentials: advertised only where the host says it is a developer's machine. *@
        @if (UiOptions.Value.ShowDevelopmentHints)
        {
            <span>Seeded admin: <code>admin@example.com</code> / <code>Admin123!</code> · </span>
        }
        No account? <NavLink href="register">Create one</NavLink>
    </p>
</EditForm>

@code {
    private readonly Credentials _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        ApiResult<TokenResponse> result = await AuthApi.LoginAsync(new LoginRequest(_model.Email, _model.Password));

        if (result.IsSuccess)
        {
            await AuthState.SignInAsync(result.Value!.AccessToken, result.Value.RefreshToken);
            Navigation.NavigateTo("invoices");
        }
        else
        {
            _error = result.Error;
            _busy = false;
        }
    }

    private sealed class Credentials
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
