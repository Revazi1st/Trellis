@page "/register"
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation
@inject INotificationService Notifier

<PageTitle>Create account — Trellis</PageTitle>

<h1>Create account</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form">
    <DataAnnotationsValidator />

    <label>
        Email
        <InputText @bind-Value="_model.Email" autocomplete="username" />
        <ValidationMessage For="() => _model.Email" />
    </label>
    <label>
        Password
        <InputText type="password" @bind-Value="_model.Password" autocomplete="new-password" />
        <ValidationMessage For="() => _model.Password" />
    </label>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Creating…" : "Create account")</button>
    <p class="hint">New accounts get the Member role (read access). Already registered? <NavLink href="login">Sign in</NavLink></p>
</EditForm>

@code {
    private readonly Registration _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        ApiResult<Guid> result = await AuthApi.RegisterAsync(new RegisterRequest(_model.Email, _model.Password));

        if (result.IsSuccess)
        {
            Notifier.Success("Account created. Sign in to continue.");
            Navigation.NavigateTo("login");
        }
        else
        {
            _error = result.Error;
            _busy = false;
        }
    }

    private sealed class Registration
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = string.Empty;
    }
}
