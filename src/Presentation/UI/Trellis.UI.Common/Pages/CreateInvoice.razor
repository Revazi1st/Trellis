@page "/invoices/new"
@inherits ProtectedPage
@inject IInvoiceApiClient InvoiceApi

<PageTitle>New invoice — Trellis</PageTitle>

<h1>New invoice</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label>Customer name<InputText @bind-Value="_model.CustomerName" /><ValidationMessage For="() => _model.CustomerName" /></label>
    <label>Customer email<InputText @bind-Value="_model.CustomerEmail" /><ValidationMessage For="() => _model.CustomerEmail" /></label>
    <label>Currency<InputText @bind-Value="_model.Currency" maxlength="3" /><ValidationMessage For="() => _model.Currency" /></label>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Creating…" : "Create draft")</button>
</EditForm>

@code {
    protected override string RequiredPermission => "invoices:write";

    private readonly Model _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        ApiResult<Guid> result = await InvoiceApi.CreateAsync(
            new CreateInvoiceRequest(_model.CustomerName, _model.CustomerEmail, _model.Currency.ToUpperInvariant()));

        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"invoices/{result.Value}");
        }
        else
        {
            _error = result.Error;
            _busy = false;
        }
    }

    private sealed class Model
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string CustomerName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string CustomerEmail { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(3, MinimumLength = 3)]
        public string Currency { get; set; } = "USD";
    }
}
