@page "/invoices/new"
@inherits ProtectedPage
@inject IInvoiceApiClient InvoiceApi

<PageTitle>New invoice — Trellis</PageTitle>

<h1>New invoice</h1>

@* No ValidationSummary: each message sits under its input, and the alert below announces the failure once. *@
<EditForm Model="_model" OnValidSubmit="SubmitAsync" class="form">
    <DataAnnotationsValidator />
    <ServerValidation @ref="_server" />

    <label>Customer name<InputText @bind-Value="_model.CustomerName" maxlength="200" /><ValidationMessage For="() => _model.CustomerName" /></label>
    <label>Customer email<InputText @bind-Value="_model.CustomerEmail" inputmode="email" maxlength="320" /><ValidationMessage For="() => _model.CustomerEmail" /></label>
    <label>Currency<InputText @bind-Value="_model.Currency" maxlength="3" /><ValidationMessage For="() => _model.Currency" /></label>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Creating…" : "Create draft")</button>
</EditForm>

@code {
    protected override string RequiredPermission => "invoices:write";

    private readonly CreateInvoiceForm _model = new();
    private ServerValidation _server = default!;
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        ApiResult<Guid> result = await InvoiceApi.CreateAsync(_model.ToRequest());

        if (result.IsSuccess)
        {
            Navigation.NavigateTo($"invoices/{result.Value}");
        }
        else
        {
            _error = _server.Show(result);
            _busy = false;
        }
    }
}
