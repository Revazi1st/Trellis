@page "/invoices/{Id:guid}"
@inherits ProtectedPage
@inject IInvoiceApiClient InvoiceApi
@inject TimeProvider Time
@inject INotificationService Notifier

<PageTitle>Invoice — Trellis</PageTitle>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}
else if (_invoice is null)
{
    <p role="status" aria-live="polite">Loading…</p>
}
else
{
    <h1>@_invoice.CustomerName</h1>

    @if (_actionError is not null)
    {
        <p class="error" role="alert">@_actionError</p>
    }

    <dl class="summary">
        <dt>Status</dt><dd>@_invoice.Status</dd>
        <dt>Email</dt><dd>@_invoice.CustomerEmail</dd>
        <dt>Total</dt><dd>@_invoice.Total.ToString("N2") @_invoice.Currency</dd>
        <dt>Due</dt><dd>@(_invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
    </dl>

    <h2>Lines</h2>
    <table class="grid">
        <thead><tr><th>Description</th><th class="num">Amount</th></tr></thead>
        <tbody>
            @foreach (InvoiceLineDto line in _invoice.Lines)
            {
                <tr><td>@line.Description</td><td class="num">@line.Amount.ToString("N2")</td></tr>
            }
        </tbody>
    </table>

    <AuthorizeView Roles="invoices:write">
        @if (_invoice.Status == InvoiceStatus.Draft)
        {
            <h2>Add line</h2>
            @* novalidate: min/step shape the inputs, the DataAnnotations messages (not browser bubbles) explain. *@
            <EditForm Model="_line" OnValidSubmit="AddLineAsync" Context="lineForm" class="form" novalidate>
                <DataAnnotationsValidator />
                <ServerValidation @ref="_lineServer" />
                <label>Description<InputText @bind-Value="_line.Description" maxlength="500" /><ValidationMessage For="() => _line.Description" /></label>
                <label>Amount<InputNumber @bind-Value="_line.Amount" step="0.01" min="0" /><ValidationMessage For="() => _line.Amount" /></label>
                @if (_lineError is not null)
                {
                    <p class="error" role="alert">@_lineError</p>
                }
                <button type="submit" disabled="@_busy">Add line</button>
            </EditForm>

            <h2>Issue</h2>
            <EditForm Model="_issue" OnValidSubmit="IssueAsync" Context="issueForm" class="form" novalidate>
                <DataAnnotationsValidator />
                <ServerValidation @ref="_issueServer" />
                <label>Due date<InputDate @bind-Value="_issue.DueDate" min="@_issue.EarliestValue" /><ValidationMessage For="() => _issue.DueDate" /></label>
                @if (_issueError is not null)
                {
                    <p class="error" role="alert">@_issueError</p>
                }
                <button type="submit" disabled="@(_busy || _invoice.Lines.Count == 0)">Issue invoice</button>
                @if (_invoice.Lines.Count == 0)
                {
                    <p class="hint">Add at least one line before issuing.</p>
                }
            </EditForm>
        }

        <div class="actions">
            @if (_invoice.Status == InvoiceStatus.Issued)
            {
                <button @onclick="PayAsync" disabled="@_busy">Mark paid</button>
            }
            @if (_invoice.Status is InvoiceStatus.Draft or InvoiceStatus.Issued)
            {
                <button class="danger" @onclick="VoidAsync" disabled="@_busy">Void</button>
            }
        </div>
    </AuthorizeView>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private InvoiceDto? _invoice;
    private string? _error;
    private string? _actionError;
    private string? _lineError;
    private string? _issueError;
    private bool _busy;
    private InvoiceLineForm _line = new();
    private IssueInvoiceForm _issue = default!;
    private ServerValidation _lineServer = default!;
    private ServerValidation _issueServer = default!;

    protected override Task OnAuthorizedAsync()
    {
        _issue = IssueInvoiceForm.At(Time.GetUtcNow());
        return LoadAsync();
    }

    // Load errors and action errors are separate fields: LoadAsync resets only its own, so a failed
    // action's message survives the reload that follows it.
    private async Task LoadAsync()
    {
        _error = null;
        ApiResult<InvoiceDto> result = await InvoiceApi.GetAsync(Id);
        if (result.IsSuccess)
        {
            _invoice = result.Value;
        }
        else
        {
            _error = result.Error;
        }
    }

    private async Task PayAsync()
    {
        _busy = true;
        ApiResult<bool> result = await InvoiceApi.PayAsync(Id, _invoice?.Version);
        _actionError = Outcome(result, "Invoice marked as paid.");
        _busy = false;
        await LoadAsync();
    }

    private async Task VoidAsync()
    {
        _busy = true;
        ApiResult<bool> result = await InvoiceApi.VoidAsync(Id, _invoice?.Version);
        _actionError = Outcome(result, "Invoice voided.");
        _busy = false;
        await LoadAsync();
    }

    private async Task AddLineAsync()
    {
        _busy = true;
        ApiResult<bool> result = await InvoiceApi.AddLineAsync(Id, _line.ToRequest(), _invoice?.Version);
        if (result.IsSuccess)
        {
            _lineError = null;
            _line = new InvoiceLineForm();
        }
        else
        {
            _lineError = _lineServer.Show(result);
        }

        _busy = false;
        await LoadAsync();
    }

    private async Task IssueAsync()
    {
        _busy = true;
        ApiResult<bool> result = await InvoiceApi.IssueAsync(Id, _issue.ToRequest(), _invoice?.Version);
        _issueError = result.IsSuccess ? null : _issueServer.Show(result);
        if (result.IsSuccess)
        {
            Notifier.Success("Invoice issued.");
        }

        _busy = false;
        await LoadAsync();
    }

    /// <summary>The action's error to show, or null after announcing its success.</summary>
    private string? Outcome(ApiResult<bool> result, string success)
    {
        if (!result.IsSuccess)
        {
            return result.Error;
        }

        Notifier.Success(success);
        return null;
    }
}
