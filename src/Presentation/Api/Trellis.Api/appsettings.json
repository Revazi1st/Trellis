{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "trellis",
    "Audience": "trellis",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ExternalApis": {
    "ExchangeRates": {
      "BaseUrl": "https://api.exchangerate.host/",
      "TimeoutSeconds": 10,
      "MaxRetries": 2
    }
  }
}
