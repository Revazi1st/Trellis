{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "trellis",
    "Audience": "trellis",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Registration": {
    "Mode": "Closed"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BaseRetryDelay": "00:00:30",
    "MaxRetryDelay": "00:15:00",
    "DispatchTimeout": "00:00:30"
  },
  "ExternalApis": {
    "ExchangeRates": {
      "BaseUrl": "https://api.frankfurter.dev/v1/",
      "TimeoutSeconds": 10,
      "MaxRetries": 2
    }
  },
  "Email": {
    "Provider": "Logging"
  }
}
