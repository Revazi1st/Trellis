<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- EmailAddressMaskTests holds Email/EmailAddressMask and Persistence's copy to the same rows, and
         OutboxRetryTests books a failed send whose error that mask wrote. -->
    <InternalsVisibleTo Include="Trellis.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Trellis.Application\Trellis.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SMTP client of Email/SmtpEmailSender.cs (MimeKit comes with it). -->
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Per-client resilience for the outbound integration (ADR-0020); ServiceDefaults' blanket
         handler cannot express a third party's own timeout budget. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

</Project>
